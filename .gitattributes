# Text files that the box executes or reads as configuration must stay LF.
* text=auto

*.sh      text eol=lf
*.service text eol=lf
*.dts     text eol=lf
*.conf    text eol=lf
*.c       text eol=lf
*.md      text eol=lf
uEnv.txt  text eol=lf

# Real binaries: never touch them.
*.dtb                            binary
*.bin                            binary
files/usr/local/bin/em95x-vfd-boot binary
