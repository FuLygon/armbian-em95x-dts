[Unit]
Description=EM95X front VFD: show BOOT until the clock service takes over
# Deliberately *not* bound to basic.target: default dependencies would schedule
# this at ~21 s, after boot.mount and fsck have waited ~9 s for the BOOT
# partition, which is irrelevant here.  Only the rootfs, /dev and the built-in
# pinctrl are needed, all of which exist when systemd starts; BOOT is on the
# display at ~10.6 s instead.
DefaultDependencies=no
After=systemd-journald.socket
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
# Same parameters as /usr/share/openvfd/conf/diy.conf. Harmless if the module
# was already loaded (modprobe is a no-op then).
ExecStartPre=-/sbin/modprobe openvfd vfd_gpio_clk=1,4,0 vfd_gpio_dat=1,5,0 vfd_gpio_stb=1,3,0 vfd_gpio0=0,0,0xFF vfd_gpio1=0,0,0xFF vfd_gpio2=0,0,0xFF vfd_gpio3=0,0,0xFF vfd_gpio_protocol=0,0 vfd_chars=4,0,1,2,3 vfd_dot_bits=0,1,2,3,4,5,6 vfd_display_type=0x02,0x00,0x01,0x00
# Writes "BOOT" in TITLE mode and keeps /dev/openvfd open so the display stays
# powered. start_service.sh stops this unit right before vfdservice takes over.
ExecStart=/usr/local/bin/em95x-vfd-boot BOOT --hold
Restart=no
TimeoutStopSec=5

[Install]
WantedBy=sysinit.target
